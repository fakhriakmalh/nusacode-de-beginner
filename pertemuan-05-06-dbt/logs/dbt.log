[0m21:57:15.319987 [debug] [Thread-1 (]: dbt_clickhouse adapter: On model.nusacode_de.gold_dim_customers: /* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "nusacode_de", "target_name": "dev", "node_id": "model.nusacode_de.gold_dim_customers"} */

            

    

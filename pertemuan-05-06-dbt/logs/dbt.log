WITH source AS (
    SELECT * FROM "dw_nusacode"."public"."dim_seller"
),

cleaned AS (
    SELECT
        seller_id,
        seller_zip_code_prefix,
        TRIM(INITCAP(seller_city)) AS seller_city,
        UPPER(TRIM(seller_state)) AS seller_state
    FROM source
)

SELECT * FROM cleaned
  );
  

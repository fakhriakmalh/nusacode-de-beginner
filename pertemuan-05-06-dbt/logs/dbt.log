-- ============================================================================
-- Gold Model: gold_fct_orders
-- Deskripsi    : Fact table untuk data pesanan. Menggabungkan order dengan
--                item, payment, dan review untuk analitik end-to-end.
--                Grain: satu baris per order (order_id).
-- ============================================================================

WITH orders AS (
    SELECT * FROM `silver`.`silver_fact_orders`
),

items AS (
    SELECT * FROM `silver`.`silver_fact_order_items`
),

payments AS (
    SELECT
        order_id,
        SUM(payment_value) AS total_payment,
        COUNT(DISTINCT payment_type) AS payment_method_count,
        groupArray(DISTINCT payment_type) AS payment_types
    FROM `silver`.`silver_fact_payments`
    GROUP BY order_id
),

reviews AS (
    SELECT
        order_id,
        AVG(review_score) AS avg_review_score,
        COUNT(review_id) AS review_count
    FROM `silver`.`silver_fact_reviews`
    GROUP BY order_id
),

joined AS (
    SELECT
        o.order_id,
        o.customer_id,
        o.order_status,
        o.is_delivered,
        o.is_canceled,
        o.order_purchase_timestamp,
        o.order_approved_at,
        o.order_delivered_customer_date,
        o.approval_hours,

        COUNT(DISTINCT i.order_item_id) AS item_count,
        SUM(i.price) AS total_price,
        SUM(i.freight_value) AS total_freight,
